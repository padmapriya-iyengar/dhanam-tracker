PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dhanam-tracker?appName=<appName>
MONGODB_LOCAL_URI=mongodb://localhost:27017/dhanam-tracker
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
OPENAI_MESSAGE_MODEL=gpt-5-mini
APP_TIMEZONE=Asia/Dubai
AUTH_SECRET=replace_with_at_least_32_random_characters
ENABLE_BOOTSTRAP_USERS=false
TRUST_PROXY=1
# Development
CORS_ORIGIN=http://localhost:3000
# Production (comma-separate multiple origins if needed)
# CORS_ORIGIN=http://84.235.253.142
