# Browser and iOS simulator:
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Responsive web application displayed inside the native parity shell.
# For an Android emulator running the local Vite app, use:
# EXPO_PUBLIC_WEB_APP_URL=http://10.0.2.2:3000/dhanam-tracker/
EXPO_PUBLIC_WEB_APP_URL=https://joshikiran.com/dhanam-tracker/

# Android emulator instead uses:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# A physical phone needs your computer's LAN IP, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.25:5000/api
