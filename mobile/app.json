{
  "expo": {
    "name": "Dhanam",
    "slug": "dhanam-mobile",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "dhanam",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dhanam.tracker",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to protect your Dhanam financial information."
      }
    },
    "android": {
      "package": "com.dhanam.tracker",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111827"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      ["expo-secure-store", { "configureAndroidBackup": false }],
      ["expo-local-authentication", { "faceIDPermission": "Use Face ID to protect your Dhanam financial information." }],
      ["expo-splash-screen", { "image": "./assets/splash.png", "imageWidth": 200, "resizeMode": "contain", "backgroundColor": "#111827" }],
      "./app.plugin.js"
    ],
    "extra": {
      "eas": {
        "projectId": "de213cf7-a7a8-47ec-bff8-ace4ca768c9f"
      }
    },
    "owner": "jkiran809"
  }
}
